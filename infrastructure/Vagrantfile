# -*- mode: ruby -*-
# vi: set ft=ruby :

VM_IP = "192.168.56.10"
TRIVY_VERSION = "0.74.0"

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_url = "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64-vagrant.box"
  config.vm.box_check_update = false

  config.vm.hostname = "devsecops-vm"
  config.vm.network "private_network", ip: VM_IP
  config.vm.network "forwarded_port", guest: 8080, host: 8080,
                    host_ip: "127.0.0.1"

  # Проект находится на уровень выше каталога infrastructure.
  config.vm.synced_folder File.expand_path("..", __dir__), "/home/vagrant/devsecops-lab", create: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "devsecops-vm"
    vb.memory = 1024
    vb.cpus = 1
  end

  config.vm.provision "shell", name: "setup", inline: <<-SHELL
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y docker.io docker-buildx curl ca-certificates tar

    # Доступ к Docker для пользователя vagrant.
    usermod -aG docker vagrant

    # Разрешаем доступ к учебному реестру по HTTP.
    mkdir -p /etc/docker
    printf '{"insecure-registries":["%s:5000"]}\n' "#{VM_IP}" > /etc/docker/daemon.json

    systemctl enable docker
    systemctl restart docker

    # Устанавливаем Trivy заданной версии с проверкой SHA-256.
    TRIVY_VERSION="#{TRIVY_VERSION}"
    TRIVY_ARCHIVE="trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"
    TRIVY_URL="https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}"

    if ! trivy --version 2>/dev/null | grep -q "Version: ${TRIVY_VERSION}"; then
      TMP_DIR="$(mktemp -d)"
      trap 'rm -rf "$TMP_DIR"' EXIT

      curl -fsSL "${TRIVY_URL}/${TRIVY_ARCHIVE}" \
        -o "${TMP_DIR}/${TRIVY_ARCHIVE}"
      curl -fsSL "${TRIVY_URL}/trivy_${TRIVY_VERSION}_checksums.txt" \
        -o "${TMP_DIR}/checksums.txt"

      cd "$TMP_DIR"
      grep -E "^[a-f0-9]{64}  ${TRIVY_ARCHIVE}$" checksums.txt \
        > expected-checksum.txt

      test -s expected-checksum.txt
      sha256sum -c expected-checksum.txt

      tar -xzf "$TRIVY_ARCHIVE" trivy
      install -m 0755 trivy /usr/local/bin/trivy
      cd /
    fi

    # Постоянный том и автоматический запуск реестра.
    docker volume create registry-data

    if ! docker container inspect registry >/dev/null 2>&1; then
      docker run -d \
        --name registry \
        --restart always \
        -p 5000:5000 \
        -v registry-data:/var/lib/registry \
        registry:3
    else
      docker update --restart always registry
      docker start registry
    fi

    # Проверяем, что необходимые компоненты доступны.
    trivy --version
    docker volume inspect registry-data
    docker ps --filter name=registry
  SHELL
end